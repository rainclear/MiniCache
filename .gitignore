# Ignore build directory generated by CMake
build/
bin/
lib/

# Ignore CMake generated files (if accidentally built in-source)
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# Ignore IDE & Editor files
.vscode/
.idea/
*.swp
*~

# Ignore compiled binary artifacts & object files
*.o
*.a
*.so
*.dylib
test_cache
test_command

# Ignore persistent log files generated during local runs
*.aof